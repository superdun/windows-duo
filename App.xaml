<Application x:Class="WindowsDuo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#111318"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1B1E26"/>
        <SolidColorBrush x:Key="TextBrush" Color="#E8EAED"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA0A8"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C9B18A"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,4,0,10"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="#2A2F3A"/>
            <Setter Property="BorderBrush" Value="#3A4150"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Application.Resources>
</Application>
