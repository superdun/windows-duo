<Window x:Class="WindowsDuo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Duo"
        Width="360" Height="620"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        WindowStyle="ToolWindow"
        Background="{StaticResource PanelBrush}"
        Foreground="{StaticResource TextBrush}"
        ShowActivated="False"
        Topmost="True"
        ShowInTaskbar="False"
        PreviewKeyDown="OnPreviewKeyDown"
        SourceInitialized="OnSourceInitialized"
        Deactivated="OnDeactivated"
        Closing="OnClosing">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20,18">
            <TextBlock Text="主屏幕实时模糊" FontSize="20" FontWeight="SemiBold"/>
            <TextBlock x:Name="StatusText"
                       Text="绕底边转轴：近轴清晰，远边均匀柔和虚化并变暗。"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,6,0,14"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="底边转轴" Click="OnHorizontal" Margin="0,0,8,8" Padding="10,6"/>
                <Button Content="左边转轴" Click="OnVertical" Margin="0,0,0,8" Padding="10,6"/>
            </StackPanel>

            <DockPanel>
                <TextBlock x:Name="AngleValue" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="0°"/>
                <TextBlock Text="转轴角度"/>
            </DockPanel>
            <Slider x:Name="AngleSlider" Minimum="0" Maximum="180" Value="0" Delay="0" IsMoveToPointEnabled="True" ValueChanged="OnParamChanged"/>

            <DockPanel>
                <TextBlock x:Name="AmountValue" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="32°"/>
                <TextBlock Text="折叠角度"/>
            </DockPanel>
            <Slider x:Name="AmountSlider" Minimum="0" Maximum="80" Value="32" Delay="0" IsMoveToPointEnabled="True" ValueChanged="OnParamChanged"/>

            <DockPanel>
                <TextBlock x:Name="GradientValue" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="0.00"/>
                <TextBlock Text="模糊均匀"/>
            </DockPanel>
            <Slider x:Name="GradientSlider" Minimum="0" Maximum="1" Value="0" Delay="0" IsMoveToPointEnabled="True" ValueChanged="OnParamChanged"/>

            <DockPanel>
                <TextBlock x:Name="HighlightValue" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="0.83"/>
                <TextBlock Text="模糊半径"/>
            </DockPanel>
            <Slider x:Name="HighlightSlider" Minimum="0" Maximum="1" Value="0.833" Delay="0" IsMoveToPointEnabled="True" ValueChanged="OnParamChanged"/>

            <DockPanel>
                <TextBlock x:Name="SheenValue" DockPanel.Dock="Right" Foreground="{StaticResource AccentBrush}" Text="1.00"/>
                <TextBlock Text="远边变暗"/>
            </DockPanel>
            <Slider x:Name="SheenSlider" Minimum="0" Maximum="1" Value="1" Delay="0" IsMoveToPointEnabled="True" ValueChanged="OnParamChanged"/>

            <TextBlock Text="0–55° 做透视虚化；再往上整屏逐渐变黑，不再继续拉伸。"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,16"/>

            <Button x:Name="ToggleButton" Content="开始实时效果" Click="OnToggle"/>
            <TextBlock Text="Esc 关闭效果。Ctrl+Shift+B 开关。点击穿透到桌面。"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       FontSize="12"/>
        </StackPanel>
    </ScrollViewer>
</Window>
